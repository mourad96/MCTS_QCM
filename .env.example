# Copy to .env and fill in the keys you actually want to use.
# LiteLLM auto-detects providers from the model string prefix:
#   openai/gpt-4o-mini, anthropic/claude-3-5-sonnet-latest, ollama/llama3, etc.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# For local Ollama, no key required, just make sure ollama serve is running:
# OLLAMA_API_BASE=http://localhost:11434
