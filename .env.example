# Copy to .env and fill in the keys you actually want to use.
# LiteLLM auto-detects providers from the model string prefix:
#   gemini/gemini-2.5-flash, openai/gpt-4o-mini, anthropic/claude-3-5-sonnet-latest, ollama/llama3, etc.

# Default CLI models use Gemini 2.5 Flash (`gemini/gemini-2.5-flash`). Get an API key at:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# For local Ollama, no key required, just make sure ollama serve is running:
# OLLAMA_API_BASE=http://localhost:11434
